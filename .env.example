# ── Mihomo (Clash.Meta) ─────────────────────────────────────────────────────
# URL of the Mihomo external controller API
MIHOMO_API_URL=http://127.0.0.1:9090

# Secret set in Mihomo config under `external-controller-secret`
MIHOMO_SECRET=your_clash_api_secret

# Name of the proxy-provider block in your Mihomo config.yaml
# (must match the key under `proxy-providers:`)
MIHOMO_PROVIDER_NAME=vless-mon

# Absolute path to the proxy-provider YAML file this daemon writes
MIHOMO_PROVIDER_PATH=/etc/mihomo/vless-mon-proxies.yaml

# Absolute path to the main Mihomo config (used only if you call reload_config)
MIHOMO_CONFIG_PATH=/etc/mihomo/config.yaml

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_CHAT_ID=-100123456789

# ── Subscription ────────────────────────────────────────────────────────────
SUBSCRIPTION_URL=https://your-sub-provider.example/sub?token=xxx
# How often (seconds) to refresh the subscription list (default 30 min)
SUBSCRIPTION_INTERVAL=1800

# ── Monitoring ──────────────────────────────────────────────────────────────
# How often (seconds) to poll all servers via Mihomo /delay API
CHECK_INTERVAL=30

# Consecutive failures required before sending a DOWN alert (anti-flapping)
FAIL_THRESHOLD=3

# Timeout passed to Mihomo's delay check, in milliseconds
CHECK_TIMEOUT=5000

# URL Mihomo uses for the latency probe
CHECK_URL=http://www.gstatic.com/generate_204

# ── Storage / Logging ───────────────────────────────────────────────────────
DB_PATH=/var/lib/vless-mon/vless_mon.db
LOG_LEVEL=INFO
LOG_FILE=/var/log/vless-mon/vless-mon.log
